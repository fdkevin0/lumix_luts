{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lumix-luts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "lumix.fdkevin.cloud",
      "custom_domain": true
    }
  ]
}
