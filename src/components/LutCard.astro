---
import type { LutEntry } from '../types/lut';

export interface Props {
  lut: LutEntry;
}

const { lut } = Astro.props;
const displayName = lut.display_name ?? lut.name_zh;
const displayDescription = lut.display_description ?? lut.description;
const desc = displayDescription.length > 80 ? displayDescription.slice(0, 80) + '...' : displayDescription;
const downloadPath = (file: (typeof lut.files)[number]) =>
  file.public_path ?? 'luts/' + lut.category + '/' + lut.id + '/' + file.name;
---

<div
  class="lut-card"
  data-category={lut.category}
  data-author={lut.author.slug}
  data-format={lut.format}
  data-size={lut.lut_3d_size?.toString() ?? ''}
  data-generator={lut.internal.generator ?? ''}
  data-tags={lut.tags.join(',')}
  data-search={`${lut.name_zh} ${lut.author.name_zh} ${lut.author.name_en} ${lut.description} ${lut.tags.join(' ')} ${lut.id}`}
>
  <a href={`/luts/${lut.id}/`}>
    {
      lut.preview_image ? (
        <img class="lut-card-img" src={`/${lut.preview_image}`} alt={lut.name_zh} loading="lazy" />
      ) : (
        <div class="preview-placeholder">暂无预览</div>
      )
    }
  </a>
  <div class="lut-card-body">
    <a href={`/luts/${lut.id}/`} class="lut-card-title">{displayName}</a>
    <div class="lut-card-author">{lut.author.name_zh}</div>
    <div class="lut-card-meta">
      <span>{lut.category_zh}</span>
      <span>.{lut.format}</span>
      {lut.lut_3d_size && <span>{lut.lut_3d_size}&sup3;</span>}
    </div>
    <div class="lut-card-tags">
      {lut.tags.slice(0, 5).map((tag) => <span class="lut-card-tag">{tag}</span>)}
    </div>
    <div class="lut-card-desc">{desc}</div>
    <div class="lut-card-actions">
      <a href={`/luts/${lut.id}/`} class="btn btn-outline">详情</a>
      {lut.files.slice(0, 1).map((file) => (
        <a href={'/' + downloadPath(file)} class="btn btn-primary" download>
          下载 .{file.type}
        </a>
      ))}
    </div>
  </div>
</div>
